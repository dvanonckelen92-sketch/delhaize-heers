---
import { LINKS } from '../consts';

const ICONS = {
  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle><path d="M2.5 3h2l2.4 12.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H6"></path></svg>',
  tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12.6 2.7 21 11a2 2 0 0 1 0 2.8l-7.2 7.2a2 2 0 0 1-2.8 0L2.7 12.7A2 2 0 0 1 2 11.3V4a1.3 1.3 0 0 1 1.3-1.3H10a2 2 0 0 1 1.4.6Z"></path><circle cx="7.3" cy="7.3" r="1.3" fill="currentColor" stroke="none"></circle></svg>',
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5A2.5 2.5 0 0 1 5.5 2H11a2 2 0 0 1 2 2v16a1.5 1.5 0 0 0-1.5-1.5H3Z"></path><path d="M21 4.5A2.5 2.5 0 0 0 18.5 2H13a2 2 0 0 0-2 2v16a1.5 1.5 0 0 1 1.5-1.5H21Z"></path></svg>',
  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><line x1="11" y1="18" x2="13" y2="18"></line></svg>',
  facebook:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H7.9V12h2.6V9.8c0-2.6 1.5-4 3.9-4 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>',
  instagram:
    '<svg viewBox="0 0 24 24"><defs><linearGradient id="tilesIgGrad" x1="0" y1="24" x2="24" y2="0"><stop offset="0%" stop-color="#FEE411"/><stop offset="30%" stop-color="#FE4880"/><stop offset="60%" stop-color="#D6249F"/><stop offset="100%" stop-color="#285AEB"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="6" fill="url(#tilesIgGrad)"/><rect x="6.2" y="6.2" width="11.6" height="11.6" rx="3.5" fill="none" stroke="white" stroke-width="1.6"/><circle cx="12" cy="12" r="3.2" fill="none" stroke="white" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="white"/></svg>',
};

const tiles = [
  {
    id: 'boodschappen',
    title: 'Online boodschappen',
    description: 'Bestel online en haal je boodschappen gratis af in de winkel met Click & Collect.',
    cta: 'Naar Collect',
    href: LINKS.collect,
    icon: ICONS.cart,
    external: true,
    featured: true,
    image: { src: '/images/tiles/boodschappen.jpg', alt: 'Rieten mand met kaas, brood, eieren en asperges', rotate: '-rotate-2' },
  },
  {
    id: 'acties-folder',
    title: 'Acties & Folder',
    description: 'Elke donderdag een nieuwe folder, geldig tot en met woensdag.',
    cta: 'Bekijk de folder',
    href: '#folder',
    icon: ICONS.tag,
    external: false,
    featured: true,
    image: { src: '/images/tiles/folder.jpg', alt: 'Stapel folders met -50% actie', rotate: 'rotate-2', position: 'object-[75%_70%]' },
  },
  {
    id: 'magazine',
    title: 'Magazine',
    description: 'Recepten, tips en inspiratie in het gratis Delhaize Magazine.',
    cta: 'Lees het magazine',
    href: LINKS.magazine,
    icon: ICONS.book,
    external: true,
    featured: false,
    image: { src: '/images/tiles/magazine.jpg', alt: 'Cover van het Delhaize Magazine', rotate: '-rotate-2' },
  },
  {
    id: 'app',
    title: 'Delhaize app',
    description: 'Al je SuperPlus-voordelen en e-Deals in één app, ook in deze winkel.',
    icon: ICONS.phone,
    featured: false,
    appBadges: true,
    image: { src: '/images/tiles/app.jpg', alt: 'Schermafbeelding van de My Delhaize-app', rotate: 'rotate-2', position: 'object-[50%_60%]' },
  },
];
---

<section class="relative overflow-hidden bg-stone-50 py-14">
  <div
    class="absolute inset-0 bg-[url('/images/tiles-bg.jpg')] bg-cover bg-center"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 bg-white/40" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Snel geregeld</h2>
    <p class="mt-2 text-slate-600">Alles wat je nodig hebt voor je bezoek aan {`Delhaize Heers`}.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        tiles.map((tile) => (
          <div
            id={tile.id}
            class:list={[
              'flex flex-col rounded-3xl border p-6 shadow-sm transition hover:shadow-md',
              tile.featured ? 'border-brand-200 bg-white' : 'border-slate-200 bg-white',
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <span
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-sm ring-1 ring-brand-100 [&_svg]:h-7 [&_svg]:w-7"
                aria-hidden="true"
                set:html={tile.icon}
              />
              <img
                src={tile.image.src}
                alt={tile.image.alt}
                width="200"
                height="140"
                class:list={[
                  'h-20 w-28 shrink-0 rounded-xl object-cover shadow-md ring-4 ring-white sm:h-24 sm:w-36',
                  tile.image.rotate,
                  tile.image.position,
                ]}
              />
            </div>
            <h3 class="mt-4 text-lg font-bold text-slate-900">{tile.title}</h3>
            <p class="mt-1 flex-1 text-sm text-slate-600">{tile.description}</p>

            {tile.appBadges ? (
              <div class="mt-4 flex flex-wrap gap-3">
                <a href={LINKS.appStore} target="_blank" rel="noopener" aria-label="Download op de App Store">
                  <img src="/images/app-store-badge.svg" alt="Download op de App Store" class="h-10 w-auto" width="120" height="40" />
                </a>
                <a href={LINKS.playStore} target="_blank" rel="noopener" aria-label="Ontdek het op Google Play">
                  <img src="/images/play-store-badge.svg" alt="Ontdek het op Google Play" class="h-10 w-auto" width="120" height="40" />
                </a>
              </div>
            ) : (
              <div class="mt-4">
                <a
                  href={tile.href}
                  target={tile.external ? '_blank' : undefined}
                  rel={tile.external ? 'noopener' : undefined}
                  class="inline-flex w-fit items-center gap-1 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
                >
                  {tile.cta}
                </a>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="relative flex flex-col overflow-hidden rounded-3xl border border-blue-100 bg-blue-50 p-6 shadow-sm transition hover:shadow-md">
        <div
          class="pointer-events-none absolute -right-6 -top-6 h-32 w-32 text-[#1877F2] opacity-10 [&_svg]:h-full [&_svg]:w-full"
          aria-hidden="true"
          set:html={ICONS.facebook}
        />
        <span
          class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-[#1877F2] shadow-sm ring-1 ring-blue-100 [&_svg]:h-7 [&_svg]:w-7"
          aria-hidden="true"
          set:html={ICONS.facebook}
        />
        <h3 class="relative mt-4 text-lg font-bold text-slate-900">Volg ons op Facebook</h3>
        <p class="relative mt-1 max-w-[85%] flex-1 text-sm text-slate-700">
          Ontvang updates, acties en nieuws via onze Facebook-pagina.
        </p>
        <div class="relative mt-4">
          <a
            href={LINKS.facebook}
            target="_blank"
            rel="noopener"
            class="inline-flex w-fit items-center gap-1 rounded-full bg-[#1877F2] px-4 py-2 text-sm font-semibold text-white hover:bg-[#1465d1]"
          >
            Like onze pagina
          </a>
        </div>
      </div>

      <div class="relative flex flex-col overflow-hidden rounded-3xl border border-pink-100 bg-gradient-to-br from-purple-50 via-pink-50 to-amber-50 p-6 shadow-sm transition hover:shadow-md">
        <div
          class="pointer-events-none absolute -right-6 -top-6 h-32 w-32 opacity-10 [&_svg]:h-full [&_svg]:w-full"
          aria-hidden="true"
          set:html={ICONS.instagram}
        />
        <span
          class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-pink-100 [&_svg]:h-7 [&_svg]:w-7"
          aria-hidden="true"
          set:html={ICONS.instagram}
        />
        <h3 class="relative mt-4 text-lg font-bold text-slate-900">Inspiratie op Instagram</h3>
        <p class="relative mt-1 max-w-[85%] flex-1 text-sm text-slate-700">
          Bekijk onze mooiste food-foto's, acties en verhalen uit de winkel op Instagram.
        </p>
        <div class="relative mt-4">
          <a
            href={LINKS.instagram}
            target="_blank"
            rel="noopener"
            class="inline-flex w-fit items-center gap-1 rounded-full bg-gradient-to-r from-purple-600 via-pink-600 to-orange-500 px-4 py-2 text-sm font-semibold text-white hover:opacity-90"
          >
            Volg ons op Instagram
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
