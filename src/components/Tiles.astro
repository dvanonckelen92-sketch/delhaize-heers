---
import { LINKS } from '../consts';

const ICONS = {
  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle><path d="M2.5 3h2l2.4 12.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H6"></path></svg>',
  tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12.6 2.7 21 11a2 2 0 0 1 0 2.8l-7.2 7.2a2 2 0 0 1-2.8 0L2.7 12.7A2 2 0 0 1 2 11.3V4a1.3 1.3 0 0 1 1.3-1.3H10a2 2 0 0 1 1.4.6Z"></path><circle cx="7.3" cy="7.3" r="1.3" fill="currentColor" stroke="none"></circle></svg>',
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5A2.5 2.5 0 0 1 5.5 2H11a2 2 0 0 1 2 2v16a1.5 1.5 0 0 0-1.5-1.5H3Z"></path><path d="M21 4.5A2.5 2.5 0 0 0 18.5 2H13a2 2 0 0 0-2 2v16a1.5 1.5 0 0 1 1.5-1.5H21Z"></path></svg>',
  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><line x1="11" y1="18" x2="13" y2="18"></line></svg>',
};

const tiles = [
  {
    id: 'boodschappen',
    title: 'Online boodschappen',
    description: 'Bestel online en haal je boodschappen gratis af in de winkel met Click & Collect.',
    cta: 'Naar Collect',
    href: LINKS.collect,
    icon: ICONS.cart,
    external: true,
    featured: true,
  },
  {
    id: 'acties-folder',
    title: 'Acties & Folder',
    description: 'Elke donderdag een nieuwe folder, geldig tot en met woensdag.',
    cta: 'Bekijk de folder',
    href: '#folder',
    icon: ICONS.tag,
    external: false,
    featured: true,
  },
  {
    id: 'magazine',
    title: 'Magazine',
    description: 'Recepten, tips en inspiratie in het gratis Delhaize Magazine.',
    cta: 'Lees het magazine',
    href: LINKS.magazine,
    icon: ICONS.book,
    external: true,
    featured: false,
  },
  {
    id: 'app',
    title: 'Delhaize app',
    description: 'Al je SuperPlus-voordelen en e-Deals in één app, ook in deze winkel.',
    icon: ICONS.phone,
    featured: false,
    appBadges: true,
  },
];
---

<section class="bg-stone-50 py-14">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Snel geregeld</h2>
    <p class="mt-2 text-slate-600">Alles wat je nodig hebt voor je bezoek aan {`Delhaize Heers`}.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        tiles.map((tile) => (
          <div
            id={tile.id}
            class:list={[
              'flex flex-col rounded-3xl border p-6 shadow-sm transition hover:shadow-md',
              tile.featured ? 'border-brand-200 bg-brand-50/40' : 'border-slate-200 bg-white',
            ]}
          >
            <span
              class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-sm ring-1 ring-brand-100 [&_svg]:h-7 [&_svg]:w-7"
              aria-hidden="true"
              set:html={tile.icon}
            />
            <h3 class="mt-4 text-lg font-bold text-slate-900">{tile.title}</h3>
            <p class="mt-1 flex-1 text-sm text-slate-600">{tile.description}</p>

            {tile.appBadges ? (
              <div class="mt-4 flex flex-wrap gap-3">
                <a href={LINKS.appStore} target="_blank" rel="noopener" aria-label="Download op de App Store">
                  <img src="/images/app-store-badge.svg" alt="Download op de App Store" class="h-10 w-auto" width="120" height="40" />
                </a>
                <a href={LINKS.playStore} target="_blank" rel="noopener" aria-label="Ontdek het op Google Play">
                  <img src="/images/play-store-badge.svg" alt="Ontdek het op Google Play" class="h-10 w-auto" width="120" height="40" />
                </a>
              </div>
            ) : (
              <div class="mt-4">
                <a
                  href={tile.href}
                  target={tile.external ? '_blank' : undefined}
                  rel={tile.external ? 'noopener' : undefined}
                  class="inline-flex w-fit items-center gap-1 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
                >
                  {tile.cta}
                </a>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
