---
import { LINKS } from '../consts';

const tiles = [
  {
    id: 'boodschappen',
    title: 'Online boodschappen',
    description: 'Bestel online en haal je boodschappen gratis af in de winkel met Click & Collect.',
    cta: 'Naar Collect',
    href: LINKS.collect,
    icon: '🛒',
    featured: true,
  },
  {
    id: 'folder',
    title: 'Acties & Folder',
    description: 'Elke donderdag een nieuwe folder, geldig tot en met woensdag.',
    cta: 'Bekijk de folder',
    href: LINKS.folder,
    icon: '📰',
    featured: true,
  },
  {
    id: 'magazine',
    title: 'Magazine',
    description: 'Recepten, tips en inspiratie in het gratis Delhaize Magazine.',
    cta: 'Lees het magazine',
    href: LINKS.magazine,
    icon: '📖',
    featured: false,
  },
  {
    id: 'app',
    title: 'Delhaize app',
    description: 'Al je SuperPlus-voordelen en e-Deals in één app, ook in deze winkel.',
    cta: 'Download de app',
    href: LINKS.appStore,
    secondaryHref: LINKS.playStore,
    icon: '📱',
    featured: false,
  },
];
---

<section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
  <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Snel geregeld</h2>
  <p class="mt-2 text-slate-600">Alles wat je nodig hebt voor je bezoek aan {`Delhaize Heers`}.</p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      tiles.map((tile) => (
        <div
          id={tile.id}
          class:list={[
            'flex flex-col rounded-2xl border p-6 shadow-sm transition hover:shadow-md',
            tile.featured ? 'border-red-200 bg-red-50/40' : 'border-slate-200 bg-white',
          ]}
        >
          <span class="text-3xl" aria-hidden="true">
            {tile.icon}
          </span>
          <h3 class="mt-3 text-lg font-bold text-slate-900">{tile.title}</h3>
          <p class="mt-1 flex-1 text-sm text-slate-600">{tile.description}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href={tile.href}
              target="_blank"
              rel="noopener"
              class="inline-flex w-fit items-center gap-1 rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700"
            >
              {tile.cta}
            </a>
            {tile.secondaryHref && (
              <a
                href={tile.secondaryHref}
                target="_blank"
                rel="noopener"
                class="inline-flex w-fit items-center gap-1 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-red-600 hover:text-red-600"
              >
                Google Play
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
