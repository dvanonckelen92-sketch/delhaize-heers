---
import { SITE, STORE, LINKS } from '../consts';
---

<section id="contact" class="border-t border-slate-200 py-14">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Kom langs</h2>
      <address class="mt-4 not-italic text-slate-600">
        <p class="font-semibold text-slate-900">{SITE.name}</p>
        <p>{STORE.streetAddress}</p>
        <p>{STORE.postalCode} {STORE.addressLocality}</p>
        <p class="mt-2">
          <a href={STORE.phoneHref} class="font-semibold text-red-600 hover:underline">{STORE.phone}</a>
        </p>
      </address>
      <a
        href={LINKS.route}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-700"
      >
        Bereken je route
      </a>
    </div>

    <div
      id="map-slot"
      class="relative flex min-h-72 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm md:min-h-full"
      data-map-src={LINKS.mapsEmbed}
      data-map-title={`Kaart met de locatie van ${SITE.name}`}
    >
      <button
        type="button"
        id="map-consent-button"
        class="flex flex-col items-center gap-2 px-6 py-8 text-center text-sm font-semibold text-slate-600 hover:text-red-600"
      >
        <span class="text-3xl" aria-hidden="true">🗺️</span>
        Toon kaart (laadt Google Maps)
      </button>
    </div>
  </div>
</section>

<script>
  const slot = document.getElementById('map-slot');
  const button = document.getElementById('map-consent-button');

  button?.addEventListener('click', () => {
    if (!slot) return;
    const src = slot.dataset.mapSrc ?? '';
    const title = slot.dataset.mapTitle ?? 'Kaart';
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = title;
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.className = 'h-72 w-full md:h-full';
    iframe.style.border = '0';
    slot.replaceChildren(iframe);
  });
</script>
