---
import { SITE, STORE, LINKS } from '../consts';

const SOCIALS = [
  {
    name: 'Facebook',
    href: LINKS.facebook,
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H7.9V12h2.6V9.8c0-2.6 1.5-4 3.9-4 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>',
  },
  {
    name: 'Google',
    href: LINKS.googleBusiness,
    icon: '<svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.4H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8Z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.1-4 1.1-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24Z"/><path fill="#FBBC05" d="M5.4 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.4a12 12 0 0 0 0 10.8l4-3.1Z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.6l4 3.1c.9-2.8 3.5-4.9 6.6-4.9Z"/></svg>',
  },
];
---

<section id="contact" class="border-t border-slate-200 py-14">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Kom langs</h2>
      <address class="mt-4 not-italic text-slate-600">
        <p class="font-semibold text-slate-900">{SITE.name}</p>
        <p>{STORE.streetAddress}</p>
        <p>{STORE.postalCode} {STORE.addressLocality}</p>
        <p class="mt-2">
          <a href={STORE.phoneHref} class="font-semibold text-brand-600 hover:underline">{STORE.phone}</a>
        </p>
      </address>
      <a
        href={LINKS.route}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Bereken je route
      </a>

      <div class="mt-8">
        <p class="text-sm font-semibold text-slate-500">Volg ons</p>
        <div class="mt-3 flex gap-3">
          {
            SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener"
                aria-label={social.name}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:border-brand-600 hover:text-brand-600 [&_svg]:h-5 [&_svg]:w-5"
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
      <iframe
        src={LINKS.mapsEmbed}
        class="h-72 w-full md:h-full"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Kaart met de locatie van ${SITE.name}`}
      ></iframe>
    </div>
  </div>
</section>
