---
import { SITE, LINKS, AGENCY } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-slate-500 sm:px-6">
    <p>
      &copy; {year} {SITE.name}. Onafhankelijk uitgebate Delhaize-winkel, onderdeel van het{' '}
      <a href={LINKS.officialStorePage} target="_blank" rel="noopener" class="underline hover:text-brand-600">
        Delhaize
      </a>{' '}
      winkelnetwerk.
    </p>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
      <a href="/privacybeleid" class="underline hover:text-brand-600">Privacybeleid</a>
      <span>
        Website door{' '}
        <a href={AGENCY.url} target="_blank" rel="noopener" class="underline hover:text-brand-600">
          {AGENCY.name}
        </a>
      </span>
    </p>
  </div>
</footer>
