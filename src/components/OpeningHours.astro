---
import { OPENING_HOURS } from '../consts';
---

<section id="openingsuren" class="border-y border-slate-200 bg-slate-50 py-14">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Openingsuren</h2>
    <p class="mt-2 text-slate-600">Elke dag open, ook op zondag.</p>

    <table class="mt-6 w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white text-left shadow-sm">
      <tbody>
        {
          OPENING_HOURS.map((d) => (
            <tr class="border-b border-slate-100 last:border-0">
              <th scope="row" class="px-5 py-3 text-sm font-semibold text-slate-700">
                {d.day}
              </th>
              <td class="px-5 py-3 text-sm text-slate-600">
                {d.opens && d.closes ? `${d.opens} – ${d.closes}` : 'Gesloten'}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
