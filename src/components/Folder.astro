---
import { LINKS } from '../consts';
---

<section id="folder" class="border-y border-slate-200 bg-slate-50 py-14">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Folder van deze week</h2>
    <p class="mt-2 text-slate-600">
      Elke donderdag een nieuwe folder, geldig tot en met woensdag. Blader hieronder door de
      actuele acties, of{' '}
      <a href={LINKS.folder} target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">
        open de folder op delhaize.be
      </a>.
    </p>

    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div id="publitas-embed-folder-heers"></div>
      <script
        is:inline
        publitas-embed
        data-wrapper-id="publitas-embed-folder-heers"
        data-cfasync="false"
        data-publication={LINKS.folderEmbed}
        data-responsive="true"
        src="https://view.publitas.com/embed.js"
        type="text/javascript"
      ></script>
    </div>
  </div>
</section>
