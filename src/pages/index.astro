---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Promos from '../components/Promos.astro';
import Tiles from '../components/Tiles.astro';
import Folder from '../components/Folder.astro';
import OpeningHours from '../components/OpeningHours.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { promosActive } from '../consts';

const showPromos = promosActive();
---

<Layout>
  <Header />
  <main>
    <Hero />
    {showPromos && <Promos />}
    <Tiles />
    <Folder />
    <OpeningHours />
    <Services />
    <Contact />
  </main>
  <Footer />
</Layout>
