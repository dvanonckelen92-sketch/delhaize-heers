---
import '../styles/global.css';
import { SITE, STORE, OPENING_HOURS, SERVICES, LINKS, COMPANY } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} | Supermarkt ${STORE.streetAddress}, ${STORE.postalCode} ${STORE.addressLocality}`,
  description = `${SITE.name} is uw buurtsupermarkt op ${STORE.streetAddress} in ${STORE.addressLocality}. Bekijk de openingsuren, de weekfolder en doe Click & Collect boodschappen.`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const logoURL = new URL('/images/delhaize-lion-logo.png', Astro.site);
// Werkelijke afmetingen van delhaize-lion-logo.png, nodig voor og:image:width/height.
const LOGO_WIDTH = 1000;
const LOGO_HEIGHT = 820;
const inLanguage = SITE.locale.replace('_', '-');

const organizationId = `${SITE.url}/#organization`;
const websiteId = `${SITE.url}/#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['GroceryStore', 'Organization'],
      '@id': organizationId,
      name: SITE.name,
      legalName: COMPANY.legalName,
      vatID: COMPANY.kboNumber,
      url: SITE.url,
      telephone: STORE.phone,
      image: logoURL.toString(),
      logo: logoURL.toString(),
      priceRange: '€€',
      currenciesAccepted: 'EUR',
      inLanguage,
      areaServed: {
        '@type': 'City',
        name: STORE.addressLocality,
      },
      hasMap: LINKS.hasMap,
      sameAs: [LINKS.facebook, LINKS.instagram, LINKS.googleBusiness, LINKS.officialStorePage],
      address: {
        '@type': 'PostalAddress',
        streetAddress: STORE.streetAddress,
        postalCode: STORE.postalCode,
        addressLocality: STORE.addressLocality,
        addressCountry: STORE.addressCountry,
      },
      // Shorthand-notatie naast openingHoursSpecification: sommige parsers en AI-antwoordmachines
      // lezen enkel dit eenvoudigere formaat.
      openingHours: OPENING_HOURS.filter((d) => d.opens && d.closes).map(
        (d) => `${d.schemaDay.slice(0, 2)} ${d.opens}-${d.closes}`,
      ),
      openingHoursSpecification: OPENING_HOURS.map((d) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: `https://schema.org/${d.schemaDay}`,
        opens: d.opens,
        closes: d.closes,
      })),
      amenityFeature: SERVICES.map((service) => ({
        '@type': 'LocationFeatureSpecification',
        name: service,
        value: true,
      })),
      knowsAbout: SERVICES,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `Diensten bij ${SITE.name}`,
        itemListElement: SERVICES.map((service) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: service },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE.url,
      name: SITE.name,
      inLanguage,
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#b01d32" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="nl-be" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="geo.placename" content={`${STORE.addressLocality}, België`} />
    <meta name="geo.region" content="BE-VLG" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={logoURL} />
    <meta property="og:image:width" content={LOGO_WIDTH.toString()} />
    <meta property="og:image:height" content={LOGO_HEIGHT.toString()} />
    <!-- TODO: vervang door een echte winkelfoto (1200x630) zodra die beschikbaar is -->

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <noscript>
      <p>
        Voor de volledige ervaring van deze website is JavaScript vereist. U kan alvast verder via
        onderstaande links:
      </p>
      <a href="/">Home</a>
      <a href="/#folder">Folder van deze week</a>
      <a href="/#openingsuren">Openingsuren</a>
      <a href="/#contact">Contact</a>
      <a href="/privacybeleid">Privacybeleid</a>
    </noscript>
    <slot />
  </body>
</html>
